# Private pack layer: the owner's directions, context, credentials, limits, schedule, spend, hosts, logs
{{PACK}}/.memory/

# Linked plugins: machine-local pointers
{{PACK}}/plugins/*.link.md

# Harness runtime files: MCP config (regenerated by Solaris mcp_sync), local settings
.mcp.json
.cursor/
.claude/settings.local.json

# Syncthing
.stfolder/
.stignore
.stversions/
*.sync-conflict-*

# Python: environments (the Kaggle gateway's .venv-kaggle/ too) and caches
.venv/
.venv-kaggle/
__pycache__/
*.pyc

# Secrets never go to git (a minted Model Proxy key lands in .env by default)
.env
*.env

# Local-only folders: __data/ (datasets and the Kaggle stores), __out/ (run outputs), __research/, __history/
__*/

# The status page (kaggle_status.py) and its source, reports/status.json, carry machines and spend: kept out of git,
# they reach the owner through file sync; the patterns also cover the temporary and shorter-chart files a killed
# build can leave
reports/status*.json
reports/status*.pdf
reports/html/status*.html

# The reporting plugin's HTML sources are working files; the PDFs it renders into reports/ are tracked
reports/html/

# Run locks the gated submit (kaggle_submit.py) leaves beside each submission record
*.json.lock

.DS_Store
