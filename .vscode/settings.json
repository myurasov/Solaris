{
  "markdown.preview.openMarkdownLinks": "inEditor",
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.preferredDarkColorTheme": "Shades of Purple (Super Dark)",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.editor.wrapTabs": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.mypy_cache": true,
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv*": false,
    "*.*": true,
    "NOTICE": true,
    "LICENSE": true
  },
  "workbench.colorCustomizations": {
    // "gitDecoration.ignoredResourceForeground": "#e3d9ff",
    "[Shades of Purple (Super Dark)]": {
      "foreground": "#ffffff",
      // "descriptionForeground": "#d5ceb3",
      // "textPreformat.foreground": "#ffe680",
      "editor.background": "#0f0f22",
      "sideBar.background": "#11111e",
      "panel.background": "#0d0d1f",
      "terminal.background": "#0d0d1f",
      // "tab.activeBackground": "#0f0f22",
      // "tab.activeForeground": "#ffe100",
      "sideBar.foreground": "#e9e4ff",
      "sideBarSectionHeader.foreground": "#ceb9dc",
      // "list.activeSelectionForeground": "#f4d406",
      // "list.activeSelectionBackground": "#645d2a",
      // "list.inactiveSelectionBackground": "#423d2b",
      // "list.hoverBackground": "#0c0ca7"
    },
  },
  // --- No hovers / no auto-popup completions; on demand only -----------------
  // Hover: Cmd+K Cmd+I. Completions: Ctrl+Space.
  "editor.hover.enabled": false,
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },

  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.parameterHints.enabled": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.inlineSuggest.enabled": false,
  // Core ships language-scoped defaults (e.g. "[json]" re-enables string
  // suggestions) that beat the generic settings above - re-assert per language.
  "[json][jsonc][yaml][markdown][python][javascript][typescript][shellscript]": {
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.hover.enabled": false
  },
  // Cursor Tab (AI autocomplete) ignores editor.inlineSuggest - disable per language.
  "cursor.cpp.disabledLanguages": [
    "json",
    "jsonc",
    "yaml",
    "markdown",
    "python",
    "javascript",
    "typescript",
    "shellscript",
    "plaintext"
  ],
  "markdown.preview.fontSize": 13,
  "problems.visibility": false,
  "git.autoRepositoryDetection": "subFolders",
  "git.repositoryScanMaxDepth": 4,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".venv",
    ".tools"
  ],
  // --- Pyright (anysphere.cursorpyright) fully disabled ---------------------
  // Its settings live under `cursorpyright.*`, NOT `python.analysis.*`
  // (that namespace belongs to Pylance, which is not installed here).
  "cursorpyright.disableLanguageServices": true,
  "cursorpyright.disablePullDiagnostics": true,
  "cursorpyright.disableOrganizeImports": true,
  "cursorpyright.disableTaggedHints": true,
  "cursorpyright.analysis.typeCheckingMode": "off",
  "cursorpyright.analysis.diagnosticMode": "openFilesOnly",
  "cursorpyright.analysis.disableWorkspaceSymbol": true,
  "cursorpyright.analysis.autoImportCompletions": false,
  "cursorpyright.analysis.useLibraryCodeForTypes": false,
  "cursorpyright.analysis.logLevel": "Error",
  "cursorpyright.analysis.exclude": [

    "**"
  ],
  "cursorpyright.analysis.ignore": [
    "**"
  ],
  // Pyrefly (meta.pyrefly) remains the sole Python checker; keep it off the
  // whole tree so it only ever analyses open files.
  "python.pyrefly.diagnosticMode": "openFilesOnly",
  "pyrefly.trace.server": "off",
  // --- File watcher: 117k of the 182k files here are .venv / node_modules ---
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tools/**": true,
    "**/*.egg-info/**": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tools/**": true,
    "**/*.egg-info/**": true
  },
  "search.followSymlinks": false
}