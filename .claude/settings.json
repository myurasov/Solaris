{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 500000,
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "claudeMdExcludes": [
    "~/.claude/rules/**/*.md"
  ],
  "permissions": {
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 3",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 4",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 5",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 6",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 7",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --part 8",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.log_interaction",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.read_first --remind",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.skill_loader",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.session_guard",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" -m solaris.tools.session_guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
