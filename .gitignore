# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# uv virtual environment (lazily created by `uv sync`)
.venv/

# Transient operation dirs (lazily created)
.tmp/
.tools/

# Runtime MCP configs carry tokens; the *.example templates stay committed.
.mcp.json
.cursor/mcp.json

# User content (per spec)
projects/
tasks/
solaris/spec/references/

# Framework-level secrets + runtime log
.memory/*
!.memory/.empty

# Claude Code: keep project settings tracked, ignore per-user local overrides
.claude/settings.local.json
.claude/agents/

.playwright*

# Syncthing folder markers (machine-local). .stglobalignore is tracked: every device's
# gitignored .stignore holds optional device-only lines first, then `#include .stglobalignore`.
# Conflict copies never belong in git (their names carry a device id).
.stfolder/
.stignore
*.sync-conflict-*

# Local-only scratch folders (the __*/ convention), including inside bundled plugins
__*/
